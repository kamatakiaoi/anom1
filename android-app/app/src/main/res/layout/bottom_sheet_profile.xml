<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Profile"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Avatar Circle in CardView to clip 100% perfectly -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnChangeAvatar"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center_horizontal"
        app:cardCornerRadius="38dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivMyAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Tap to change"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#80000000" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Display name"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etProfileName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_box"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_dim"
        android:hint="@string/name_hint"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:maxLength="24"
        android:textSize="14sp"
        android:inputType="textPersonName" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cooldown_hint"
        android:textColor="@color/text_subtle"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp" />

    <!-- Timezone Switch -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/timezone_label"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_segment"
        android:padding="3dp"
        android:layout_marginBottom="18dp">

        <TextView
            android:id="@+id/btnTzVn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tz_vietnam"
            android:textColor="@color/accent_black"
            android:background="@drawable/bg_btn_primary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnTzUtc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tz_utc"
            android:textColor="@color/text_muted"
            android:background="@android:color/transparent"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Notification Sound Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notification Sound"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Actions: Cancel and Save -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btnProfileCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textColor="#CCCCCC"
            android:background="@drawable/bg_card_topic"
            android:gravity="center"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnProfileSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/save"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_green"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Logout Button -->
    <TextView
        android:id="@+id/btnProfileLogout"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Log Out"
        android:textColor="@color/status_red"
        android:background="@drawable/bg_card_topic"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
