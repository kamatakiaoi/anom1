<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anonymous Chat"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your key to login or register"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Error Text -->
        <TextView
            android:id="@+id/tvAuthError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/status_red"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Loading Indicator Panel -->
        <LinearLayout
            android:id="@+id/panelAuthLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbAuthLoading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/accent_primary"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvAuthLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connecting..."
                android:textColor="@color/accent_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Key Input -->
        <EditText
            android:id="@+id/etAuthKeyInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_search_box"
            android:hint="Your private key..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:gravity="center"
            android:textSize="15sp"
            android:maxLength="64"
            android:inputType="textVisiblePassword"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:layout_marginBottom="14dp" />

        <!-- Login Button -->
        <TextView
            android:id="@+id/btnAuthLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Login"
            android:textColor="#0A0A0A"
            android:background="@drawable/bg_btn_primary"
            android:foreground="?android:attr/selectableItemBackground"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="14dp" />

        <!-- Divider -->
        <LinearLayout
            android:id="@+id/panelAuthDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/border_subtle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="or"
                android:textColor="@color/text_subtle"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/border_subtle" />
        </LinearLayout>

        <!-- Register Button -->
        <TextView
            android:id="@+id/btnAuthRegister"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Register with this Key"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_card_topic"
            android:foreground="?android:attr/selectableItemBackground"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <!-- Registration Success Recovery Key Box -->
        <LinearLayout
            android:id="@+id/panelRecoveryDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Recovery Key:"
                android:textColor="@color/text_muted"
                android:textSize="12.5sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvRecoveryKeyDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search_box"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:padding="14dp"
                android:gravity="center"
                android:textIsSelectable="true"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap the key to copy it"
                android:textColor="@color/text_subtle"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save this recovery key! It can restore your login key if you forget it. It cannot be recovered otherwise."
                android:textColor="@color/status_red"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/btnAuthContinue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="I Have Saved My Recovery Key - Continue"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_green"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Toggle Recover Form -->
        <TextView
            android:id="@+id/btnToggleRecover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot your key? Recover it"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/panelRecoverForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etRecoveryKeyInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_search_box"
                android:hint="Your recovery key..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:gravity="center"
                android:textSize="15sp"
                android:maxLength="64"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/btnAuthRecover"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Recover My Key"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_card_topic"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Server Settings Section (Collapsible) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/btnToggleServerSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvServerConfigLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server: snow.pikamc.vn:25222"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelServerConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_topic"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server IP / Host"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etAuthServerHost"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_box"
                android:textColor="@color/text_primary"
                android:hint="@string/server_ip_hint"
                android:textColorHint="@color/text_dim"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="14sp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Port"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etAuthServerPort"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_box"
                android:textColor="@color/text_primary"
                android:hint="@string/server_port_hint"
                android:textColorHint="@color/text_dim"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="14sp"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:id="@+id/btnSaveServerConfig"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Reconnect Server"
                android:textColor="#0A0A0A"
                android:background="@drawable/bg_btn_primary"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:textSize="14.5sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
