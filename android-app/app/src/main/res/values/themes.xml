<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AnonymousChat" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_white</item>
        <item name="colorPrimaryVariant">@color/accent_pure_white</item>
        <item name="colorOnPrimary">@color/accent_black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/status_blue</item>
        <item name="colorSecondaryVariant">@color/status_rec_cyan</item>
        <item name="colorOnSecondary">@color/accent_pure_white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_primary</item>

        <!-- Silky smooth activity transitions across the entire app -->
        <item name="android:windowAnimationStyle">@style/CustomWindowAnimations</item>

        <!-- Bottom Sheet Dialog transparent background to remove grey/white square outline -->
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>
    </style>

    <style name="CustomWindowAnimations">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetModalStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
    </style>

    <style name="CustomBottomSheetModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Theme.AnonymousChat.Fullscreen" parent="Theme.AnonymousChat">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
