<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:paddingStart="10dp"
    android:paddingEnd="48dp">

    <!-- Avatar (Left) -->
    <ImageView
        android:id="@+id/ivMsgAvatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top"
        android:scaleType="centerCrop"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start">

        <!-- Sender Name -->
        <TextView
            android:id="@+id/tvMsgName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Message Bubble -->
            <LinearLayout
                android:id="@+id/bubbleLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_other_only"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Reply Box Quote -->
                <LinearLayout
                    android:id="@+id/replyQuoteBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_quote_other"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvQuoteName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_quote_name"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvQuoteText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Text Body -->
                <TextView
                    android:id="@+id/tvMsgBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.2"
                    android:autoLink="web"
                    android:textColorLink="@color/text_link" />

                <!-- Images Grid / Row -->
                <LinearLayout
                    android:id="@+id/mediaContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

                <!-- Video Container (Inline playback + fullscreen trigger) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMsgVideo"
                    android:layout_width="230dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="4dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#000000"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/msgVideoFrame"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivMsgVideoThumb"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <VideoView
                            android:id="@+id/vvMsgVideoInline"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/pbVideoLoading"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/accent_pure_white"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/btnPlayVideo"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_play"
                            android:background="@drawable/bg_btn_circle"
                            android:padding="10dp" />

                        <ImageView
                            android:id="@+id/btnFullscreenVideo"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="6dp"
                            android:src="@drawable/ic_fullscreen"
                            android:background="@drawable/bg_btn_circle"
                            android:padding="5dp"
                            android:visibility="gone" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Audio Container -->
                <include
                    android:id="@+id/audioPlayerView"
                    layout="@layout/view_audio_player"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Reply Button (Right of bubble) -->
            <ImageView
                android:id="@+id/btnReplyMsg"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_reply"
                android:background="@drawable/bg_btn_circle"
                android:backgroundTint="#18181B"
                android:padding="6dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvMsgTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:layout_marginTop="3dp"
            android:layout_gravity="start" />

    </LinearLayout>

</LinearLayout>
