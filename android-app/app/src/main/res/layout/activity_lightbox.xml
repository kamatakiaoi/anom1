<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.anonymous.chat.views.ZoomableImageView
        android:id="@+id/ivLightboxImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <VideoView
        android:id="@+id/vvLightboxVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/pbLightboxLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone" />

    <!-- Center Play/Pause Indicator -->
    <ImageView
        android:id="@+id/ivVideoCenterPlay"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_play"
        android:background="@drawable/bg_btn_circle"
        android:backgroundTint="#80000000"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Top Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutTopControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnLightboxRotate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_rotate"
            android:background="@drawable/bg_btn_circle"
            android:backgroundTint="#80000000"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnLightboxClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@drawable/bg_btn_circle"
            android:backgroundTint="#80000000"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Bottom Video Controls HUD -->
    <LinearLayout
        android:id="@+id/layoutVideoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_video_bottom_gradient"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnVideoPlayPause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_pause"
                android:background="@drawable/bg_btn_circle"
                android:backgroundTint="#80000000"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvVideoCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp" />

            <SeekBar
                android:id="@+id/sbVideoProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF"
                android:splitTrack="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/tvVideoDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp" />

            <ImageView
                android:id="@+id/btnVideoFullscreen"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_fullscreen"
                android:background="@drawable/bg_btn_circle"
                android:backgroundTint="#80000000"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
